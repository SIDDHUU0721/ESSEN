# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/essen_db

# Redis Connection (Optional / Fallback provided in app)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=essen_super_secure_jwt_secret_key_2026_x99!
JWT_REFRESH_SECRET=essen_super_secure_refresh_secret_key_2026_z88!
JWT_EXPIRES_IN=7d

# ESSEN AI & Generative Services
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Payment Gateway (Razorpay / Stripe / Mock Mode)
PAYMENT_PROVIDER=mock
PAYMENT_KEY=rzp_test_essen_demo_key
PAYMENT_SECRET=rzp_secret_essen_demo_secret

# Media & Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=essen-media
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Maps & Geolocation
MAPS_API_KEY=your_google_maps_api_key
